{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "env": {
    "es2024": true,
    "node": true
  },
  "ignorePatterns": ["docs/api/"],
  "rules": {
    "eqeqeq": "error",
    "unicorn/no-empty-file": "off"
  }
}
