{
  "name": "@daevox/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./test-support.ts"
  },
  "scripts": {
    "db:push": "drizzle-kit push --config=drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "verify": "npm run typecheck && npm test"
  },
  "dependencies": {
    "drizzle-orm": "1.0.0-rc.4"
  },
  "engines": {
    "node": ">= 26",
    "npm": ">= 12"
  }
}
