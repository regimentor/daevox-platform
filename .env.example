# Local backend and browser origin. No cookies or Daevox login are used.
# SQLite URL; relative file: paths are resolved from the repository root.
# Absolute paths are supported: file:///absolute/path/to/db/daevox.sqlite
DATABASE_URL=file:./db/daevox.sqlite
# Local llama-server OpenAI-compatible API. Empty model selects /v1/models automatically.
LLAMA_BASE_URL=http://127.0.0.1:3188/v1
LLAMA_MODEL=smollm-validation
PORT=3000
WEB_CLIENT_ORIGIN=http://127.0.0.1:5173
# Vite dev-server proxy target; never exposed to browser code.
API_PROXY_TARGET=http://127.0.0.1:3000

# Replace placeholders locally. Never commit real values.
TELEGRAM_API_ID=YOUR_API_ID
TELEGRAM_API_HASH=YOUR_API_HASH
# Stable 32-byte encryption key, encoded as base64. Keep it between restarts.
TELEGRAM_DATABASE_KEY=YOUR_BASE64_KEY
# Absolute, persistent, distinct directories outside this repository.
TELEGRAM_DATABASE_DIRECTORY=/absolute/path/outside/repository/telegram/database
TELEGRAM_FILES_DIRECTORY=/absolute/path/outside/repository/telegram/files

# Local transcription Vite proxy, with the intentionally exact /trancription-api/ prefix.
TRANSCRIPTION_PROXY_TARGET=http://127.0.0.1:3001

# Python transcription backend reads this root .env automatically.
# Example configuration, not Settings defaults: choose available GPUs and a running LLM.
# Prepare the selected TTS engine separately; see apps/transcription-backend/README.md.
# Without overrides the code selects Silero and RTX 4070 Ti for all three GPU settings.
TRANSCRIPTION_TTS_ENGINE=cosyvoice
TRANSCRIPTION_TTS_GPU="NVIDIA GeForce RTX 4070 Ti"
TRANSCRIPTION_ASR_GPU="NVIDIA GeForce RTX 5080"
TRANSCRIPTION_DIARIZATION_GPU="NVIDIA GeForce RTX 5080"
TRANSCRIPTION_LLM_MODEL=smollm-validation
TRANSCRIPTION_LLM_BASE_URL=http://127.0.0.1:3188/v1
TRANSCRIPTION_SEPARATION_MODEL=htdemucs
TRANSCRIPTION_SEPARATION_CHECKPOINT_PATH=~/.cache/torch/hub/checkpoints/955717e8-8726e21a.th
TRANSCRIPTION_SEPARATION_CHECKPOINT_SHA256=8726e21a993978c7ba086d3872e7608d7d5bfca646ca4aca459ffda844faa8b4

TRANSCRIPTION_COSYVOICE_WORKERS=2

# Local core; export these for Cargo and use the actual Vite origin.
CORE_PORT=3188
CORE_WEB_ORIGIN=http://localhost:5173
CORE_PROXY_TARGET=http://127.0.0.1:3188
