{
  "name": "@daevox/tdlib",
  "version": "0.0.0",
  "private": true,
  "description": "Typed zero-runtime-dependency TDLib client for Node.js 26",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "generate": "node scripts/generate-types.ts && oxfmt src/generated/td-api.ts",
    "check:generated": "node scripts/check-generated.ts",
    "check": "npm run typecheck && npm run check:generated",
    "typecheck": "tsc -p tsconfig.json",
    "test": "npm run test:unit",
    "test:unit": "node --test test/tdlib-client.test.ts",
    "test:native": "mise exec -- node --experimental-ffi test/native-smoke.test.ts",
    "verify": "npm run check && npm run test:unit && npm run test:native"
  },
  "engines": {
    "node": ">= 26",
    "npm": ">= 12"
  }
}
